@model QuanLyHocVu.Models.TaiKhoan

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h3>Đăng Nhập</h3>
            </div>
            <div class="card-body">
                <form asp-action="Login">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="TenDangNhap" class="control-label mb-1">Tên đăng nhập</label>
                        <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập tên đăng nhập..." />
                        <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="MatKhau" class="control-label mb-1">Mật khẩu</label>
                        <input asp-for="MatKhau" class="form-control" placeholder="Nhập mật khẩu..." />
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>
                    <div class="form-group d-grid">
                        <input type="submit" value="Đăng Nhập" class="btn btn-primary btn-block" />
                    </div>
                </form>
            </div>
            <div class="card-footer text-center">
                <a href="#">Quên mật khẩu?</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
