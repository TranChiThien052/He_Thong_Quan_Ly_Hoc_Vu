@model QuanLyHocVu.Models.TaiKhoan
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Học Vụ</title>
    <link rel="stylesheet" href="~/css/login/style.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-left"></div>

        <div class="login-right">
            <div class="login-form-wrapper">
                <div class="login-header">
                    <h2>Đăng Nhập</h2>
                </div>
                <form asp-action="Login" method="post">
                    <div class="form-group">
                        <label asp-for="TenDangNhap" class="form-label">Tên đăng nhập</label>
                        <input asp-for="TenDangNhap" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
                        <input asp-for="MatKhau" type="password" class="form-control"/>
                    </div>
                    <button type="submit" class="btn-login">Đăng Nhập</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
