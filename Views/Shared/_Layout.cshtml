                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "TaiKhoan" ? "active" : "")">
                        <a href="#">Qu?n lý tài kho?n</a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main -->
        <main class="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
