<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - QU?N LÝ SINH VIÊN</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="layout">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-logo"> <a asp-controller="Home" asp-action="Index"><img src="~/img/logo.jpg" alt="Logo" style="height: 30px; vertical-align: middle; margin-right: 5px;" /> STU</a></div>
                <div class="brand-name">Tru?ng Ð?i H?c Công Ngh? Sài Gòn</div>
            </div>
            <nav class="menu">
                <ul>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                        <a asp-controller="Admin" asp-action="Index">Qu?n lý sinh viên</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "GiangVien" ? "active" : "")">
                        <a href="#">Qu?n lý gi?ng viên</a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "MonHoc" ? "active" : "")">
                        <a href="#">Qu?n lý môn h?c</a>
                    </li>
