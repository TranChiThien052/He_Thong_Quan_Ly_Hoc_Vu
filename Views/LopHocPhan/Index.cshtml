@model IEnumerable<QuanLyHocVu.Models.LopHocPhan>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NgayHoc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GioBatDau)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GioKetThuc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaGiangVienNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaHocKyNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaMonHocNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhongHocNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NgayHoc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GioBatDau)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GioKetThuc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaGiangVienNavigation.MaNguoiDung)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaHocKyNavigation.MaHocKy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaMonHocNavigation.MaMonHoc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhongHocNavigation.MaPhong)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaLopHocPhan">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaLopHocPhan">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaLopHocPhan">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
