@model IEnumerable<QuanLyHocVu.Models.HocPhi>
@{
    ViewData["Title"] = "Học phí";
}

<div class="container bg-white p-4 rounded shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="text-primary mb-0">Danh sách học phí</h4>
      <a asp-action="Create" class="btn btn-primary">+ Thêm học phí</a>
    </div>

    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Mã học phí</th>
          <th>Giá theo tín</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var hocPhi in Model)
        {
            <tr>
              <td>@hocPhi.MaHocPhi</td>
              <td>@String.Format("{0:N0} VND", hocPhi.GiaTheoTin)</td>
              <td><a asp-action="Edit" asp-route-id="@hocPhi.MaHocPhi" class="btn btn-small">Sửa</a></td>
            </tr>
        }
      </tbody>
    </table>
  </div>