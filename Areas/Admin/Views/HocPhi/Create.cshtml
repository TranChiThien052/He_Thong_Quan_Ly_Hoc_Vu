@model QuanLyHocVu.Models.HocPhi
@{
    ViewData["Title"] = "Học phí";
}

<div class="container bg-white p-4 rounded shadow-sm" style="max-width: 500px;">
    <h4 class="mb-4 text-primary">Thêm học phí</h4>

    <form asp-action="Create" method="post">
      <div class="mb-3">
        <label class="form-label fw-bold">Mã học phí</label>
        <input asp-for="MaHocPhi" type="text" class="form-control" placeholder="VD: HPLT">
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold">Giá theo tín</label>
        <input asp-for="GiaTheoTin" type="number" step="1000" min="0" class="form-control" placeholder="VD: 450000">
      </div>

      <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </div>
    </form>
  </div>