@model IEnumerable<QuanLyHocVu.Models.ChuongTrinhDaoTao>

@{
  ViewData["Title"] = "Quản lý chương trình đào tạo";
}

<h1 class="mb-4">Quản lý chương trình đào tạo</h1>
<div class="container bg-white p-4 rounded shadow-sm">

    <!-- Form lọc -->
    <form class="row g-3 mb-4">
        <div class="col-md-4">
            <label for="nganh" class="form-label">Ngành</label>
            <select class="form-select" id="nganh" asp-items="ViewBag.Nganhs">
            </select>
        </div>
        <div class="col-md-5">
            <label for="tenCTDT" class="form-label">Tên chương trình</label>
            <input type="text" class="form-control" id="tenCTDT" placeholder="Nhập tên chương trình...">
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>
            <button type="reset" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-clockwise"></i> Làm mới
            </button>
        </div>
    </form>
    <hr>

    <!-- Tiêu đề thêm chương trình -->
    <h4 class="mb-3 text-success">Thêm chương trình đào tạo</h4>

    <!-- Form thêm chương trình -->
    <form class="row g-3" asp-action="Create" method="post">
    <div class="col-md-2">
        <label for="maCTDTMoi" class="form-label">Mã CTĐT</label>
        <input type="text" class="form-control" id="maCTDTMoi" name="maCTDTMoi" placeholder="VD: CNTT2024" required>
    </div>
    <div class="col-md-4">
        <label for="tenCTDTMoi" class="form-label">Tên CTĐT</label>
        <input type="text" class="form-control" id="tenCTDTMoi" name="tenCTDTMoi" placeholder="VD: Công nghệ thông tin nâng cao" required>
    </div>
    <div class="col-md-4">
        <label for="nganhMoi" class="form-label">Ngành</label>
        <div class="d-flex gap-2">
            <select class="form-select h-100" id="nganhMoi" name="nganhMoi" asp-items="ViewBag.Nganhs">
            </select>
            <button type="submit" class="btn btn-success h-100">Thêm</button>
        </div>
    </div>
</form>
<br>

    <!-- Bảng danh sách -->
    <table class="table table-bordered table-hover mb-5">
        <thead class="table-light">
            <tr>
                <th>Mã CTĐT</th>
                <th>Tên chương trình</th>
                <th>Tên ngành</th>
                <th>Tổng tín chỉ</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaCtdt</td>
                        <td>@item.TenCtdt</td>
                        <td>@item.MaNganhNavigation?.TenNganh</td>
                        <td>@item.ChiTietChuongTrinhDaoTaos.Sum(ct => ct.MaMonHocNavigation?.SoTinChi ?? 0)</td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = item.MaCtdt })" class="btn btn-sm btn-warning">Sửa</a>
                            <a href="@Url.Action("Delete", new { id = item.MaCtdt })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa không?');">Xóa</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
