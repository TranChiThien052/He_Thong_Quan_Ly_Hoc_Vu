@model QuanLyHocVu.Models.Nganh

@{
    ViewData["Title"] = "Thêm Ngành";
}

    <div class="container bg-white p-4 rounded shadow-sm">
        <h4 class="mb-4 text-primary">Thêm Khoa - Ngành</h4>

        <form>
            <!-- Mã khoa -->
            <div class="mb-4">
                <label for="maKhoa" class="form-label">Mã khoa</label>
                <input type="text" class="form-control" id="maKhoa" placeholder="Nhập mã khoa (ví dụ: KH001)">
            </div>

            <!-- Danh sách ngành dạng bảng -->
            <div class="mb-3">
                <label class="form-label">Chọn các ngành</label>
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">Chọn</th>
                            <th>Mã ngành</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="nganh[]" value="GV001">
                            </td>
                            <td>GV001</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="nganh[]" value="GV002">
                            </td>
                            <td>GV002</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="nganh[]" value="GV003">
                            </td>
                            <td>GV003</td>
                        </tr>
                        <!-- Có thể thêm nhiều dòng ngành khác tại đây -->
                    </tbody>
                </table>
            </div>

            <!-- Nút hành động -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="reset" class="btn btn-secondary">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>