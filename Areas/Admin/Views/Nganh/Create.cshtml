@model QuanLyHocVu.Models.Nganh

@{
    ViewData["Title"] = "Thêm Ngành";
}

    <div class="container bg-white p-4 rounded shadow-sm">
        <h4 class="mb-4 text-primary">Thêm Ngành</h4>

        <form asp-action="Create" method="post">
            <!-- Mã ngành -->
            <div class="mb-4">
                <label asp-for="MaNganh" class="form-label">Mã Ngành</label>
                <input type="text" class="form-control" asp-for="MaNganh" placeholder="Nhập mã ngành (ví dụ: CNTT)">
            </div>
            <!-- Tên ngành -->
            <div class="mb-4">
                <label asp-for="TenNganh" class="form-label">Tên Ngành</label>
                <input type="text" class="form-control" asp-for="TenNganh" placeholder="Nhập tên ngành">
            </div>

            <!-- Danh sách ngành dạng bảng -->
            <div class="mb-3">
                <label class="form-label">Chọn các khoa</label>
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">Chọn</th>
                            <th>Mã khoa</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="khoa[]" value="KTP">
                            </td>
                            <td>Khoa Công Nghệ Thực Phẩm</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="khoa[]" value="KCB">
                            </td>
                            <td>Khoa Cơ Bản</td>
                        </tr>
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="khoa[]" value="GV003">
                            </td>
                            <td>GV003</td>
                        </tr>
                        <!-- Có thể thêm nhiều dòng ngành khác tại đây -->
                    </tbody>
                </table>
            </div>

            <!-- Nút hành động -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="reset" class="btn btn-secondary">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>