@model QuanLyHocVu.Models.Nganh

@{
    ViewData["Title"] = "Sửa Ngành";
}

    <div class="container bg-white p-4 rounded shadow-sm">
        <h4 class="mb-4 text-primary">Sửa Ngành</h4>

        <form asp-action="Edit" method="post">
            <!-- Mã ngành -->
            <div class="mb-4">
                <label asp-for="MaNganh" class="form-label">Mã Ngành</label>
                <input type="text" class="form-control" asp-for="MaNganh" readonly>
            </div>
            <!-- Tên ngành -->
            <div class="mb-4">
                <label asp-for="TenNganh" class="form-label">Tên Ngành</label>
                <input type="text" class="form-control" asp-for="TenNganh">
            </div>

            <!-- Danh sách ngành dạng bảng -->
            <div class="mb-3">
                <label class="form-label">Chọn các khoa</label>
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">Chọn</th>
                            <th>Mã khoa</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach(var khoa in ViewBag.Khoas)
                    {
                        bool isChecked = Model.KhoaNganhs.Any(kn => kn.MaKhoa == khoa.MaKhoa);
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                    name="khoa[]"
                                    value="@khoa.MaKhoa"
                                    @(isChecked ? "checked" : "") />
                            </td>
                            <td>@khoa.TenKhoa</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- Nút hành động -->
            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="reset" class="btn btn-secondary">Hủy</button>
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>