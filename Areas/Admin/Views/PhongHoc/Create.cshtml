@model QuanLyHocVu.Models.PhongHoc

@{
    ViewData["Title"] = "Thêm phòng học";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container bg-white p-4 rounded shadow-sm">
    <h4 class="mb-4">Thêm phòng học</h4>

    <form asp-action="Create" method = "post">
      <div class="row g-3">
        <!-- Tầng -->
        <div class="col-md-3">
          <label for="tang" class="form-label">Tầng</label>
          <input type="text" class="form-control" name="tang" id="tang" placeholder="VD: 1" oninput="capNhatMaPhong() required">
        </div>

        <!-- Khu -->
        <div class="col-md-3">
          <label for="khu" class="form-label">Khu</label>
          <input type="text" class="form-control" name="khu" id="khu" placeholder="VD: A" oninput="capNhatMaPhong()" required>
        </div>

        <!-- 2 số cuối -->
        <div class="col-md-3">
          <label for="soPhong" class="form-label">Số phòng</label>
          <input type="text" class="form-control" name="soPhong" id="soPhong" placeholder="VD: 01" minlength="1" maxlength="2" oninput="capNhatMaPhong()" required>
        </div>

        <!-- Loại phòng -->
        <div class="col-md-3">
          <label for="loaiPhong" class="form-label">Loại phòng</label>
          <select name="LoaiPhong" class="form-select" id="loaiPhong">
            <option value="Lý thuyết">Lý thuyết</option>
            <option value="Thực hành">Thực hành</option>
            <option value="Đồ án">Đồ án</option>
          </select>
        </div>
      </div>

      <!-- Mã phòng học -->
      <div class="row mt-4">
        <div class="col-md-6">
          <input type="hidden" class="form-control" id="maPhong" name="maPhong">
        </div>
      </div>

      <!-- Nút hành động -->
      <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </div>
    </form>
  </div>

  <script>
    function capNhatMaPhong() {
      const khu = document.getElementById("khu").value.trim().toUpperCase();
      const tang = document.getElementById("tang").value.trim();
      const soPhong = document.getElementById("soPhong").value.trim().padStart(2, '0');

      const maPhong = (khu && tang && soPhong.length == 2) ? `${khu}${tang}${soPhong}` : "";
      document.getElementById("maPhong").value = maPhong;
    }
  </script>