@model IEnumerable<QuanLyHocVu.Models.PhongHoc>

@{
    ViewData["Title"] = "Quản lý Phòng học";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container bg-white p-4 rounded shadow-sm">
    <h4 class="mb-4">Quản lý phòng học</h4>

    <!-- Form lọc -->
    <form class="row g-3 mb-4" method="get" asp-action="Index">
      <div class="col-md-5">
        <label for="loaiPhong" class="form-label">Loại phòng</label>
        <select class="form-select" name="loaiPhong" asp-items="ViewBag.LoaiPhong">
          <option value="" selected>Tất cả</option>

        </select>
      </div>
      <div class="col-md-5">
        <label for="tang" class="form-label">Tầng</label>
        <select class="form-select" name="tang" asp-items="ViewBag.Tang">
          <option value="" selected>Tất cả</option>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
      </div>
    </form>

    <!-- Nút thêm -->
    <div class="mb-3 text-end">
      <a asp-action="Create" class="btn btn-success">+ Thêm phòng học</a>
    </div>

    <!-- Bảng danh sách -->
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Mã phòng</th>
          <th>Tầng</th>
          <th>Khu</th>
          <th>Loại phòng</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model){

        <tr>
            <td>@item.MaPhong</td>
            <td>@item.Tang</td>
            <td>@item.Khu</td>
            <td>@item.LoaiPhong</td>
            <td><a asp-action = "Edit" asp-route-id ="@item.MaPhong" class="btn btn-sm btn-warning">Sửa</a></td>
        </tr>

      }
      </tbody>
    </table>
  </div>