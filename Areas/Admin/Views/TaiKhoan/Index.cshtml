@model IEnumerable<QuanLyHocVu.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản Lý Tài Khoản";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Danh Sách Tài Khoản</h1>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-users me-1"></i>
            Thông Tin Tài Khoản
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã Người Dùng</th>
                            <th>Họ Tên</th>
                            <th>Tên Đăng Nhập</th>
                            <th>Trạng Thái</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaNguoiDung</td>
                                <td class="fw-bold text-primary">
                                    @item.MaNguoiDungNavigation?.HoTen
                                </td>
                                <td>@item.TenDangNhap</td>
                                <td>
                                    @if (item.TrangThai == "Hoạt động")
                                    {
                                        <span class="badge bg-success">@item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == "Khóa")
                                    {
                                        <span class="badge bg-danger">@item.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.TrangThai</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.MaNguoiDung" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
