@model IEnumerable<QuanLyHocVu.Models.LopHocPhan>

@{
    ViewData["Title"] = "Quản lý lớp học phần";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container bg-white p-4 rounded shadow-sm">
    <h4 class="mb-4 text-primary">Quản lý lớp học phần</h4>

    <!-- Bộ lọc -->
    <form class="row g-3 mb-4">
      <div class="col-md-3">
        <label for="caHoc" class="form-label">Ca học</label>
        <select class="form-select" id="caHoc">
          <option selected disabled>-- Chọn ca học --</option>
          <option value="1">Ca 1</option>
          <option value="2">Ca 2</option>
          <option value="3">Ca 3</option>
          <option value="4">Ca 4</option>
        </select>
      </div>
      <div class="col-md-3">
        <label for="ngayHoc" class="form-label">Ngày học</label>
        <select class="form-select" id="ngayHoc">
          <option selected disabled>-- Chọn ngày học --</option>
          <option value="2">Thứ 2</option>
          <option value="3">Thứ 3</option>
          <option value="4">Thứ 4</option>
          <option value="5">Thứ 5</option>
          <option value="6">Thứ 6</option>
          <option value="7">Thứ 7</option>
        </select>
      </div>
      <div class="col-md-3">
        <label for="hocKy" class="form-label">Học kỳ</label>
        <select class="form-select" id="hocKy">
          <option selected disabled>-- Chọn học kỳ --</option>
          <option value="1">Học kỳ 1</option>
          <option value="2">Học kỳ 2</option>
        </select>
      </div>
      <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary w-50">Tìm kiếm</button>
        <button type="reset" class="btn btn-outline-secondary w-50">Tải lại</button>
      </div>
    </form>

    <div class="mb-3 text-end">
      <a asp-action="Create" class="btn btn-success">+ Thêm lớp học phần</a>
    </div>

    <h5 class="mb-3">Danh sách lớp học phần</h5>
    <table class="table table-bordered table-hover">
      <thead class="table-light">
        <tr>
          <th>Mã lớp học phần</th>
          <th>Tên môn học</th>
          <th>Giảng viên</th>
          <th>Học kỳ</th>
          <th>Năm học</th>
          <th>Ca học</th>
          <th>Ngày học</th>
          <th>Phòng học</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var item in Model){
        <tr>
          <td>@item.MaLopHocPhan</td>
          <td>@item.MaMonHocNavigation?.TenMonHoc</td>
          <td>@item.MaGiangVienNavigation?.HoTen</td>
          <td>@item.MaHocKyNavigation?.HocKySo</td>
          <td>@item.MaHocKyNavigation?.NamHoc</td>
          <td>@item.CaHoc</td>
          <td>@item.NgayHoc</td>
          <td>@item.PhongHoc</td>
          <td><a asp-action="Edit" asp-route-id="@item.MaLopHocPhan" class="btn btn-sm btn-warning">Sửa</a></td>
        </tr>
      }
      </tbody>
    </table>
  </div>