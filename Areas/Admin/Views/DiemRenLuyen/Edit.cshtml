@model QuanLyHocVu.Models.DiemRenLuyen

@{
    ViewData["Title"] = "Cập nhật điểm rèn luyện";
}

<div class="container bg-white p-4 rounded shadow-sm" style="max-width: 600px;">
    <h4 class="mb-4 text-primary">Cập nhật điểm rèn luyện</h4>

    <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaSinhVien" />
            <input type="hidden" asp-for="MaHocKy" />
            <div class="form-group">
                <label asp-for="MaSinhVien" class="control-label">Mã sinh viên</label>
                <input asp-for="MaSinhVien" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="MaSinhVienNavigation.HoTen" class="control-label">Họ và tên</label>
                <input asp-for="MaSinhVienNavigation.HoTen" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="MaHocKyNavigation.MaHocKy" class="control-label">Mã học kỳ</label>
                <input asp-for="MaHocKyNavigation.MaHocKy" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Diem" class="control-label"></label>
                <input asp-for="Diem" class="form-control" type="number" min="0" max="100" />
                <span asp-validation-for="Diem" class="text-danger"></span>
            </div>

      <div class="d-flex justify-content-end mt-4">
        <a asp-action="Index" class="btn btn-secondary me-2">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </div>
    </form>
  </div>