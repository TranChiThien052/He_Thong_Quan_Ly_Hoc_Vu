@model QuanLyHocVu.Models.DiemRenLuyen

@{
    ViewData["Title"] = "Sửa điểm rèn luyện";
}

<h1>Sửa điểm rèn luyện</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaSinhVien" />
            <input type="hidden" asp-for="MaHocKy" />
            <div class="form-group">
                <label asp-for="MaSinhVien" class="control-label"></label>
                <input asp-for="MaSinhVien" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="MaSinhVienNavigation.HoTen" class="control-label"></label>
                <input asp-for="MaSinhVienNavigation.HoTen" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="MaHocKyNavigation.MaHocKy" class="control-label"></label>
                <input asp-for="MaHocKyNavigation.MaHocKy" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label asp-for="Diem" class="control-label"></label>
                <input asp-for="Diem" class="form-control" type="number" min="0" max="100" />
                <span asp-validation-for="Diem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}