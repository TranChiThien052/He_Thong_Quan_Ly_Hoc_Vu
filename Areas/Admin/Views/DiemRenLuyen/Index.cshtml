@model IEnumerable<QuanLyHocVu.Models.DiemRenLuyen>

@{
    ViewData["Title"] = "Quản lý điểm rèn luyện";
}

<div class="container-fluid">
    <h1 class="mt-4">Quản lý điểm rèn luyện</h1>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách điểm rèn luyện
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <form asp-action="Index" method="get" class="row g-3 mb-3">
                <div class="col-md-4">
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Tìm kiếm theo tên hoặc mã sinh viên..." />
                </div>
                <div class="col-md-4">
                    <select name="maHocKy" class="form-select" asp-items="ViewBag.MaHocKy"></select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> Làm mới
                    </a>
                </div>
            </form>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Mã Sinh Viên</th>
                        <th>Họ Tên</th>
                        <th>Học Kỳ</th>
                        <th>Điểm Rèn Luyện</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaSinhVien</td>
                            <td>@item.MaSinhVienNavigation.HoTen</td>
                            <td>@item.MaHocKyNavigation.MaHocKy</td>
                            <td>@item.Diem</td>
                            <td>
                                <a asp-action="Edit" asp-route-maSinhVien="@item.MaSinhVien" asp-route-maHocKy="@item.MaHocKy" class="btn btn-sm btn-primary">Sửa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
