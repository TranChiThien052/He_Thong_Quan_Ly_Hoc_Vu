@model QuanLyHocVu.Models.SinhVien

@{
    ViewData["Title"] = "Xóa Sinh Viên";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Xóa Sinh Viên</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Sinh Viên</a></li>
        <li class="breadcrumb-item active">Xóa</li>
    </ol>

    <div class="card mb-4 shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <i class="fas fa-exclamation-triangle me-1"></i>
            Xác Nhận Xóa
        </div>
        <div class="card-body">
            <h4 class="text-danger">Bạn có chắc chắn muốn xóa sinh viên này?</h4>
            <p class="text-muted">Hành động này không thể hoàn tác.</p>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Mã Sinh Viên</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MaNguoiDung)</dd>

                        <dt class="col-sm-4">Họ Tên</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.HoTen)</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4">Số Điện Thoại</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.SoDienThoai)</dd>
                        
                        <dt class="col-sm-4">Ngành</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MaNganhNavigation.TenNganh)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Niên Khóa</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NienKhoa)</dd>

                        <dt class="col-sm-4">Tình Trạng</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TinhTrangHoc)</dd>

                        <dt class="col-sm-4">CCCD</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Cccd)</dd>
                    </dl>
                </div>
            </div>
            
            <form asp-action="Delete">
                <input type="hidden" asp-for="MaNguoiDung" />
                <div class="d-flex justify-content-end mt-3">
                    <a asp-action="Index" class="btn btn-secondary me-2">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-trash-alt me-1"></i> Xác Nhận Xóa</button>
                </div>
            </form>
        </div>
    </div>
</div>
