@model IEnumerable<QuanLyHocVu.Models.DiemCongTacXaHoi>

@{
    ViewData["Title"] = "Quản lý điểm công tác xã hội";
}

<div class="container-fluid">
    <h1 class="mt-4">Quản lý điểm công tác xã hội</h1>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Danh sách điểm công tác xã hội
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 mb-3">
                <div class="col-md-6">
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Tìm kiếm theo tên hoặc mã sinh viên..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                </div>
            </form>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Mã Sinh Viên</th>
                        <th>Họ Tên</th>
                        <th>Tổng Điểm CTXH</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaSinhVien</td>
                            <td>@item.MaSinhVienNavigation.HoTen</td>
                            <td>@item.TongDiem</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal-@item.MaSinhVien">
                                    Cập nhật
                                </button>

                                <!-- Modal -->
                                <div class="modal fade" id="editModal-@item.MaSinhVien" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Cập nhật điểm CTXH - @item.MaSinhVienNavigation.HoTen</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="Edit" method="post">
                                                <div class="modal-body">
                                                    <input type="hidden" name="maSinhVien" value="@item.MaSinhVien" />
                                                    <div class="mb-3">
                                                        <label class="form-label">Tổng điểm</label>
                                                        <input type="number" name="tongDiem" class="form-control" value="@item.TongDiem" min="0" />
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
