@model IEnumerable<QuanLyHocVu.Models.MonHoc>

@{
    ViewData["Title"] = "Quản lý Môn học (Admin)";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Dùng layout chính tạm thời
}


<header class="topbar">
        <h1>Quản lý môn học</h1>
        <div class="actions">
          <input type="text" placeholder="Tìm kiếm môn học..." class="search-input" />
          <button class="btn btn-primary">+ Thêm môn học</button>
        </div>
      </header>

      <!-- Table -->
      <section class="card">
        <div class="card-header"><h2>Danh sách môn học</h2></div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mã môn học</th>
                <th>Tên môn học</th>
                <th>Số tín chỉ</th>
                <th>Loại môn</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaMonHoc</td><td>@item.TenMonHoc</td><td>@item.SoTinChi</td><td>@item.LoaiMon</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaMonHoc" class="btn btn-small">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaMonHoc" class="btn btn-small btn-danger">Xóa</a>
                    </td>
                </tr>
            }
            </tbody>
          </table>
        </div>
      </section>
