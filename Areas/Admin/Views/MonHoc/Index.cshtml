@model IEnumerable<QuanLyHocVu.Models.MonHoc>

@{
    ViewData["Title"] = "Quản lý Môn học (Admin)";
}

@section Styles {
    <!-- Liên kết CSS cục bộ -->
    <link rel="stylesheet" href="~/css/admin/style.css" />
}

<header class="topbar">
        <h1>Quản lý môn học</h1>
</header>

      <!-- Table -->
        <form method="get" asp-action="Index" class="mb-4">
          <div class="row g-3">
              <div class="col-md-3">
                  <label class="form-label fw-bold">Loại môn</label>
                  <select name="loaiMon" class="form-select" asp-items="ViewBag.LoaiMon">
                      <option value="">Tất cả</option>
                  </select>
              </div>
              <div class="col-md-3">
                  <label class="form-label fw-bold">Tên môn học</label>
                  <input type="text" name="tenMonHoc" class="form-control" value="@ViewBag.CurrentTenMonHoc" />
              </div>
              <div class="col-md-4 d-flex align-items-end">
                  <button type="submit" class="btn btn-primary me-2">
                      <i class="fas fa-search"></i> Tìm kiếm
                  </button>
                  <a asp-action="Index" class="btn btn-secondary">
                      <i class="fas fa-redo"></i> Làm mới
                  </a>
              </div>
              <div class="actions">
                <button type="button" class="btn btn-primary btn-add" onclick="location.href='@Url.Action("Create", "MonHoc", new { area = "Admin" })'">+ Thêm môn học</button>
              </div>
          </div>
      </form>

      <section class="card" id="list-subject">
        <div class="card-header"><h2>Danh sách môn học</h2></div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Mã môn học</th>
                <th>Tên môn học</th>
                <th>Số tín chỉ</th>
                <th>Loại môn</th>
                <th>Thao tác</th>
              </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MaMonHoc</td>
                    <td>@item.TenMonHoc</td>
                    <td>@item.SoTinChi</td>
                    <td>@item.LoaiMon</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaMonHoc" class="btn btn-small">Sửa</a>
                    </td>
                </tr>
            }
            </tbody>
          </table>
        </div>
      </section>
      


  
