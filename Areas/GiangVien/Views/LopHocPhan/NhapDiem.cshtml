@model QuanLyHocVu.Models.DiemHocPhan

@{
    ViewData["Title"] = "Nhập điểm sinh viên";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<div class="container bg-white p-4 rounded shadow-sm" style="max-width: 600px;">
    <h4 class="mb-4 text-primary">Nhập điểm sinh viên</h4>

    <form method="post" asp-controller="LopHocPhan" asp-action="NhapDiem">
      <!-- Thông tin sinh viên -->
      <div class="mb-3">
        <label class="form-label">Mã số sinh viên: </label>
        <span class="text-primary fw-bold">@Model.MaSinhVien</span>
        <input type="hidden" name="MaSinhVien" value="@Model.MaSinhVien">
        <input type="hidden" name="MaLopHocPhan" value="@ViewBag.maLopHocPhan">
      </div>
      <div class="mb-3">
        <label class="form-label">Họ tên sinh viên: </label>
        <span class="text-primary fw-bold">@Model.MaSinhVienNavigation?.HoTen</span>
      </div>

      <!-- Nhập điểm -->
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <label class="form-label">Điểm chuyên cần</label>
          <input type="number" step="0.1" class="form-control" name="DiemChuyenCan" min="0" max="10" required value="@Model.DiemChuyenCan">
        </div>
        <div class="col-md-4">
          <label class="form-label">Điểm giữa kỳ</label>
          <input type="number" step="0.1" class="form-control" name="DiemGiuaKy" min="0" max="10" required value="@Model.DiemGiuaKy">
        </div>
        <div class="col-md-4">
          <label class="form-label">Điểm cuối kỳ</label>
          <input type="number" step="0.1" class="form-control" name="DiemCuoiKy" min="0" max="10" required value="@Model.DiemCuoiKy">
        </div>
      </div>

      <!-- Nút hành động -->
      <div class="d-flex justify-content-end gap-2">
        <a asp-action="Details" asp-route-id="@Model.MaLopHocPhan" class="btn btn-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </div>
    </form>
  </div>