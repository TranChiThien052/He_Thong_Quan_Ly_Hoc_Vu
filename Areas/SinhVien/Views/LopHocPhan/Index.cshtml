@model IEnumerable<QuanLyHocVu.Models.LopHocPhan>

@{
    ViewData["Title"] = "Danh sách Lớp Học Phần";
}

<h1>Danh sách Lớp Học Phần</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CaHoc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NgayHoc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaGiangVienNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaHocKyNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaMonHocNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhongHocNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CaHoc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NgayHoc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaGiangVienNavigation.HoTen)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaHocKyNavigation.MaHocKy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaMonHocNavigation.TenMonHoc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PhongHocNavigation.MaPhong)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.MaLopHocPhan">Details</a>
            </td>
        </tr>
}
    </tbody>
</table>